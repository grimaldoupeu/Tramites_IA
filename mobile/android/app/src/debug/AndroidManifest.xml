<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- SOLO en debug: en desarrollo el backend corre en la red local con HTTP sin
         cifrar (http://IP:8000), que Android bloquea por defecto desde la versión 9.
         Las compilaciones release no heredan este permiso y exigen HTTPS. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
