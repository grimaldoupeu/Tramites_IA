# Copia este archivo como .env y completa los valores reales.
# ¡Nunca subas el archivo .env al repositorio!

# URL del proyecto de Supabase (Settings > API > Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave secreta service_role (Settings > API). Omite RLS: úsala solo en el backend.
SUPABASE_SERVICE_KEY=tu-clave-service-role

# Clave de la API de Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=tu-clave-de-gemini

# Opcional: modelo de Gemini a usar (por defecto gemini-3.8-flash)
# GEMINI_MODELO=gemini-3.8-flash
# GEMINI_MODELO_RESPALDO=gemini-3.5-flash-lite
